Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Opsional: Jika ingin memaksa HTTPS di hosting cPanel nanti, 
  # hilangkan tanda '#' pada 2 baris di bawah ini:
  
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Redirect all non-existent files/directories to index.html (SPA Fallback)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
